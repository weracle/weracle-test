{
  "functions": {
    "api/hyphen.js": {
      "maxDuration": 60
    },
    "api/send-fax.js": {
      "maxDuration": 60
    },
    "api/fax-webhook.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/tilko/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/c/:slug",
      "destination": "/card/card.html?u=:slug"
    },
    {
      "source": "/@:slug",
      "destination": "/card/card.html?u=:slug"
    }
  ]
}
